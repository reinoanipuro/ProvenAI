{
  "domain": "Escape routes",
  "regulation_file": "escape_routes.md",
  "rules": [
    {
      "id": "ER-1",
      "title": "Escape route clear width",
      "attribute": "escape_route_width",
      "kind": "numeric",
      "dimension": "length",
      "operator": ">=",
      "threshold": "1200",
      "unit": "mm",
      "clause": "1.1",
      "threshold_quote": "at least 1200 mm",
      "query": "minimum clear width of an escape route",
      "labels": ["escape route clear width", "clear width of escape route", "corridor clear width"]
    },
    {
      "id": "ER-2",
      "title": "Travel distance to stairway",
      "attribute": "travel_distance",
      "kind": "numeric",
      "dimension": "length",
      "operator": "<=",
      "threshold": "30",
      "unit": "m",
      "clause": "1.2",
      "threshold_quote": "shall not exceed 30 m",
      "query": "maximum travel distance from a cabin door to the nearest stairway",
      "labels": ["travel distance"]
    },
    {
      "id": "ER-3",
      "title": "Emergency lighting illuminance",
      "attribute": "emergency_lighting_illuminance",
      "kind": "numeric",
      "dimension": "illuminance",
      "operator": ">=",
      "threshold": "1",
      "unit": "lx",
      "clause": "2.1",
      "threshold_quote": "at least 1 lux",
      "query": "minimum illuminance of emergency lighting along escape routes",
      "labels": ["emergency lighting illuminance", "illuminance on escape routes"]
    }
  ]
}
