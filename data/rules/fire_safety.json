{
  "domain": "Fire safety",
  "regulation_file": "fire_safety.md",
  "rules": [
    {
      "id": "FS-1",
      "title": "Fire door class",
      "attribute": "fire_door_class",
      "kind": "classification",
      "operator": ">=",
      "threshold": "A-30",
      "class_prefix": "A",
      "scale": ["A-0", "A-15", "A-30", "A-60"],
      "clause": "1.1",
      "threshold_quote": "at least A-30",
      "query": "required fire resistance class of doors in a main fire zone boundary",
      "labels": ["fire door class", "fire door rating"]
    },
    {
      "id": "FS-2",
      "title": "Emergency lighting duration",
      "attribute": "emergency_lighting_duration",
      "kind": "numeric",
      "dimension": "time",
      "operator": ">=",
      "threshold": "60",
      "unit": "min",
      "clause": "2.1",
      "threshold_quote": "at least 60 minutes",
      "query": "how long emergency lighting must operate after a power failure",
      "labels": ["emergency lighting duration", "emergency lighting autonomy"]
    }
  ]
}
